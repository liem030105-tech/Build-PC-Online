# Sao chép file này thành .env.local rồi điền địa chỉ API Xano của bạn.
# Lấy ở Xano: API > chọn nhóm API > nút "Copy" cạnh Base URL.

# Nhóm API chứa các endpoint /build (và /auth nếu để chung nhóm).
VITE_XANO_API_URL=

# Chỉ điền khi các endpoint /auth nằm ở một nhóm API khác.
VITE_XANO_AUTH_URL=
